<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lineageos.pepito.beaconnotifier">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Only platform-signed senders (XiaomiParts) may hand us a beacon. -->
    <permission android:name="org.lineageos.pepito.beaconnotifier.POST"
                android:protectionLevel="signature" />

    <application android:label="@string/app_name"
                 android:icon="@drawable/ic_beacon">

        <receiver android:name=".BeaconReceiver"
                  android:exported="true"
                  android:permission="org.lineageos.pepito.beaconnotifier.POST">
            <intent-filter>
                <action android:name="org.lineageos.pepito.beaconnotifier.BEACON" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
