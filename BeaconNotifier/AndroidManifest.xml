<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lineageos.pepito.beaconnotifier">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />


    <application android:label="@string/app_name"
                 android:icon="@drawable/ic_beacon">

        <!-- Exported so XiaomiParts (system UID) can reach it; the receiver itself
             rejects any sender that is not the system UID. -->
        <receiver android:name=".BeaconReceiver"
                  android:exported="true">
            <intent-filter>
                <action android:name="org.lineageos.pepito.beaconnotifier.BEACON" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
