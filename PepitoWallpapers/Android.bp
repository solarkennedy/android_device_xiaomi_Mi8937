//
// Wallpaper partner customization APK for the Palm PVG100 (pepito).
// Resources only -- no Java sources, hence hasCode="false" in the manifest.
//

android_app {
    name: "PepitoWallpapers",

    // A device has exactly ONE wallpaper partner: DefaultPartnerProvider
    // .findSystemApk() returns the first receiver matching
    // ACTION_PARTNER_CUSTOMIZATION and never iterates further. Lineage's
    // Backgrounds app claims that slot (vendor/lineage/config/common_mobile.mk),
    // so shipping alongside it left this package installed but never read.
    // Replace it outright; its 11 wallpapers are carried over in res/.
    overrides: ["Backgrounds"],

    resource_dirs: ["res"],
    sdk_version: "current",

    // Nothing to shrink or obfuscate in a resource-only package, and R8 would
    // otherwise strip resources that are only referenced from res/xml/wallpapers.xml
    // (the picker resolves them at runtime by resource id).
    optimize: {
        enabled: false,
    },
}
