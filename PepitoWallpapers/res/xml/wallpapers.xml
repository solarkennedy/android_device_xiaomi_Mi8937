<?xml version="1.0" encoding="utf-8"?>
<!--
     Parsed by WallpaperPicker2 DefaultCategoryProvider.getSystemCategories().

     Note both "title" and "src" are read with getAttributeResourceValue(), so
     they MUST be resource references - a literal string silently yields 0 and
     the entry is dropped. "id" is the one plain string (getAttributeValue).

     "src" must point at an encoded bitmap: ResourceAsset feeds openRawResource()
     to BitmapFactory, so an XML shape/color drawable would decode to null.
-->
<wallpapers>

    <!-- The six wallpapers that shipped on stock Palm 8.1 (v1AML-0), lifted from
         system/app/WallpaperPicker/WallpaperPicker.apk res/drawable-nodpi-v4.
         All are 720x1280, matching the FT8613 panel exactly. -->
    <category
        id="pepito_stock"
        title="@string/category_palm"
        priority="1">
        <static-wallpaper id="pepito_water" src="@drawable/water" title="@string/wallpaper_water" />
        <static-wallpaper id="pepito_plant" src="@drawable/plant" title="@string/wallpaper_plant" />
        <static-wallpaper id="pepito_heart" src="@drawable/heart" title="@string/wallpaper_heart" />
        <static-wallpaper id="pepito_pink" src="@drawable/pink" title="@string/wallpaper_pink" />
        <static-wallpaper id="pepito_gold" src="@drawable/gold" title="@string/wallpaper_gold" />
        <static-wallpaper id="pepito_donut" src="@drawable/donut" title="@string/wallpaper_donut" />
    </category>

    <!-- The stock LineageOS wallpapers. This package overrides Backgrounds
         (org.lineageos.backgrounds), which used to own the single partner slot and
         published these through the legacy "partner_wallpapers" string-array. That
         array is only read from the winning partner, so carrying the images here is
         what keeps them available. Names match Backgrounds' arrays.xml exactly;
         ascension_teal_dark is on disk there but is not published, so it is omitted. -->
    <category
        id="pepito_lineage"
        title="@string/category_lineage"
        priority="2">
        <static-wallpaper id="lineage_ascension_blaze" src="@drawable/ascension_blaze" title="@string/lineage_blaze" />
        <static-wallpaper id="lineage_ascension_ice" src="@drawable/ascension_ice" title="@string/lineage_ice" />
        <static-wallpaper id="lineage_ascension_mist" src="@drawable/ascension_mist" title="@string/lineage_mist" />
        <static-wallpaper id="lineage_ascension_shade" src="@drawable/ascension_shade" title="@string/lineage_shade" />
        <static-wallpaper id="lineage_ascension_sunset" src="@drawable/ascension_sunset" title="@string/lineage_sunset" />
        <static-wallpaper id="lineage_ascension_teal" src="@drawable/ascension_teal_light" title="@string/lineage_teal" />
        <static-wallpaper id="lineage_expansion" src="@drawable/expansion" title="@string/lineage_expansion" />
        <static-wallpaper id="lineage_operation" src="@drawable/operation" title="@string/lineage_operation" />
        <static-wallpaper id="lineage_progression" src="@drawable/progression" title="@string/lineage_progression" />
        <static-wallpaper id="lineage_propulsion" src="@drawable/propulsion" title="@string/lineage_propulsion" />
        <static-wallpaper id="lineage_tessellation" src="@drawable/tessellation" title="@string/lineage_tessellation" />
    </category>

    <!-- Generated by tools/gen-solids.py. -->
    <category
        id="pepito_solids"
        title="@string/category_solids"
        priority="3">
        <static-wallpaper id="solid_black" src="@drawable/solid_black" title="@string/solid_black" />
        <static-wallpaper id="solid_charcoal" src="@drawable/solid_charcoal" title="@string/solid_charcoal" />
        <static-wallpaper id="solid_slate" src="@drawable/solid_slate" title="@string/solid_slate" />
        <static-wallpaper id="solid_bone" src="@drawable/solid_bone" title="@string/solid_bone" />
        <static-wallpaper id="solid_indigo" src="@drawable/solid_indigo" title="@string/solid_indigo" />
        <static-wallpaper id="solid_blue" src="@drawable/solid_blue" title="@string/solid_blue" />
        <static-wallpaper id="solid_teal" src="@drawable/solid_teal" title="@string/solid_teal" />
        <static-wallpaper id="solid_green" src="@drawable/solid_green" title="@string/solid_green" />
        <static-wallpaper id="solid_amber" src="@drawable/solid_amber" title="@string/solid_amber" />
        <static-wallpaper id="solid_orange" src="@drawable/solid_orange" title="@string/solid_orange" />
        <static-wallpaper id="solid_crimson" src="@drawable/solid_crimson" title="@string/solid_crimson" />
        <static-wallpaper id="solid_plum" src="@drawable/solid_plum" title="@string/solid_plum" />
    </category>

</wallpapers>
