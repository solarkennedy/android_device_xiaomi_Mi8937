<?xml version="1.0" encoding="utf-8"?>
<!--
     Wallpaper partner customization APK for the Palm PVG100 (pepito).

     WallpaperPicker2's DefaultPartnerProvider.findSystemApk() locates this via
     PackageManager.queryBroadcastReceivers() for ACTION_PARTNER_CUSTOMIZATION,
     and requires ApplicationInfo.FLAG_SYSTEM. The receiver below exists purely
     as that discovery marker - it is never actually broadcast to, which is why
     it has no implementation class of its own (same as Backgrounds' .StubReceiver,
     which is also a name with no code behind it). The picker then reads
     res/xml/wallpapers.xml straight out of these resources.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lineageos.pepito.wallpapers">

    <application
        android:label="@string/wallpapers_label"
        android:hasCode="false"
        android:allowBackup="false">

        <!--
             MUST be exported. queryBroadcastReceivers() does not return
             non-exported components to a caller in another package, so an
             unexported marker is invisible to the picker no matter that it is
             correctly declared. Note "adb shell cmd package query-receivers"
             DOES list it either way - shell bypasses that filtering - so it is
             not a valid check. Lineage's Backgrounds exports its StubReceiver
             for exactly this reason.
        -->
        <receiver
            android:name=".StubReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.android.launcher3.action.PARTNER_CUSTOMIZATION" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
