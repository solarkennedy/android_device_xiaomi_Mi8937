<?xml version="1.0" encoding="utf-8"?>
<!--
     Wallpaper partner customization APK for the Palm PVG100 (pepito).

     WallpaperPicker2's DefaultPartnerProvider.findSystemApk() locates this via
     PackageManager.queryBroadcastReceivers() for ACTION_PARTNER_CUSTOMIZATION,
     and requires ApplicationInfo.FLAG_SYSTEM. The receiver below exists purely
     as that discovery marker - it is never actually broadcast to, which is why
     it has no implementation class of its own. The picker then reads
     res/xml/wallpapers.xml straight out of these resources.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lineageos.pepito.wallpapers">

    <application
        android:label="@string/wallpapers_label"
        android:hasCode="false"
        android:allowBackup="false">

        <receiver
            android:name="android.content.BroadcastReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.android.launcher3.action.PARTNER_CUSTOMIZATION" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
