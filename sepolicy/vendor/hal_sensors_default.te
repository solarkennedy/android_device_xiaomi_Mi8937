# BHy sensor hub sysfs access for BST HAL (pepito)
allow hal_sensors_default sysfs_bhy:file rw_file_perms;
allow hal_sensors_default sysfs_bhy:dir r_dir_perms;

# BHy calibration profiles under /data/misc/sensor. The path is hardcoded in
# the prebuilt sensors.native.so blob, so it cannot be relocated to
# /data/vendor as Treble would normally require. domain.te's
# "vendor domains may only access files in /data/vendor" neverallow permits a
# vendor domain no more than {append getattr ioctl read write map} on a
# core_data_file_type -- not even open -- so the documented violators
# exemption is the only way to grant create/unlink here.
typeattribute hal_sensors_default data_between_core_and_vendor_violators;
allow hal_sensors_default bhy_data_file:dir rw_dir_perms;
allow hal_sensors_default bhy_data_file:file create_file_perms;
