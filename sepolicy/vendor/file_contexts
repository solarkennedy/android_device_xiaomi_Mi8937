# Gatekeeper
/(vendor|system/vendor)/bin/hw/android\.hardware\.gatekeeper@1\.0-service\.software  u:object_r:hal_gatekeeper_default_exec:s0

# Pepito keymaster trustlet staging for qseecom firmware mirror.
/(vendor|system/vendor)/bin/init\.pepito\.qseecom\.sh  u:object_r:init_pepito_qseecom_exec:s0
/(vendor|system/vendor)/etc/keymaster-firmware(/.*)?  u:object_r:firmware_file:s0

# IR
/dev/spidev7.1	u:object_r:ir_device:s0

# OverlayFS
/(vendor|system/vendor)/bin/overlayfs/[0-9a-z-_]+/mm-qcamera-daemon	u:object_r:mm-qcamerad_exec:s0

# Partitions
/dev/block/platform/soc/7824900\.sdhci/by-name/cust     u:object_r:system_block_device:s0
/dev/block/platform/soc/7824900\.sdhci/by-name/oem      u:object_r:metadata_block_device:s0
/dev/block/platform/soc/7824900\.sdhci/by-name/system   u:object_r:system_block_device:s0

# Touchscreen
/sys/devices(/platform)?/soc/78b7000\.i2c/i2c-3/3-[0-9a-f]+(/.*)?	u:object_r:sysfs_mi8937_ts:s0

# qmux (pepito ipc_router modem transport) — stock A8 rmt_storage runs in the
# rmt_storage domain; qcrild uses the existing rild domain (rild_exec label).
/(vendor|system/vendor)/bin/qmux_rmt_storage	u:object_r:rmt_storage_exec:s0

# Palm EFS backing partition 'tunning' (mmcblk0p18), served by the A8
# rmt_storage as a modem EFS client. p13/p14/p16 already get this label from
# qcom sepolicy-legacy-um; 'tunning' is a Palm-only by-name entry (harmless on
# siblings, where the path never exists).
/dev/block/platform/soc/7824900\.sdhci/by-name/tunning	u:object_r:modem_efs_partition_device:s0
