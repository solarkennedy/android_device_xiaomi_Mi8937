allow init sysfs_mi8937_mach:dir r_dir_perms;
allow init sysfs_mi8937_mach:file r_file_perms;

# Allow init bind mounting vendor files (camera config overlays). The
# firmware_file/mnt_vendor_file mounton rules that used to sit here served the
# retired pepito qseecom firmware mirror.
allow init vendor_file:file mounton;
allow init vendor_configs_file:dir mounton;
allow init vendor_configs_file:file mounton;
