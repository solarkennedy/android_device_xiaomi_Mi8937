# qmux (pepito) — modem QMI over the legacy IPC Router (AF_MSM_IPC), which maps
# to the generic 'socket' class on this kernel. See PLAN-qmux.md / PLAN-qmux-bridge.md.
#
# qmux_rmt_storage is labeled rmt_storage_exec (file_contexts) so it runs in the
# rmt_storage domain and inherits its uio/efs/socket perms. Deltas vs the stock
# QRTR rmt_storage:

# It loads its private A8 QMI lib closure from /vendor/lib64/qmux (vendor_file)
# plus the vendor libc++ (same_process_hal_file).
allow rmt_storage vendor_file:file { read getattr open execute map };
allow rmt_storage same_process_hal_file:file { read getattr open execute map };

# The A8 rmt_storage links libdiag and opens /dev/diag.
allow rmt_storage diag_device:chr_file rw_file_perms;

# qcrild talks the ipc_router (generic socket) now; the base rild domain only
# had self:socket ioctl (its QRTR path uses qipcrtr_socket).
allow rild self:socket create_socket_perms;

# qcrild preloads libqmi_force_ipcr.so, whose socket() shim reads the qmux
# enable prop in-process to decide whether to force the ipc_router backend.
get_prop(rild, vendor_qmux_prop)

# netmgrd (qmux_netmgrd) is a QMI client on the ipc_router (generic socket)
# via the same force-ipcr preload; same pair of rules as rild above.
allow netmgrd self:socket create_socket_perms;
get_prop(netmgrd, vendor_qmux_prop)

# The IMS daemons (imsqmidaemon/imsdatadaemon in the ims domain,
# ims_rtp_daemon in hal_imsrtp) carry the same preload and the same
# ipc_router (generic socket) QMI path.
allow ims self:socket create_socket_perms;
get_prop(ims, vendor_qmux_prop)
allow hal_imsrtp self:socket create_socket_perms;
get_prop(hal_imsrtp, vendor_qmux_prop)

# ims_enabler — VoLTE NV self-heal boot oneshot (init.qmux.rc, PLAN-volte.md).
# A QMI client on the ipc_router (generic socket) like the daemons above;
# reads the qmux gate props (its own check + the force-ipcr preload) and
# reports its outcome in vendor.qmux.ims_enabler. Vendor-lib loading (dlopen
# of libqmi_cci/libqmiservices) is covered by the global non-coredomain
# vendor_file_type rules in system/sepolicy.
type ims_enabler, domain;
type ims_enabler_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(ims_enabler)

allow ims_enabler self:socket create_socket_perms;
# Plain `socket ioctl` trips the global neverallowxperm allowlist requirement
# (domain.te); scope it to the IPC-router service-discovery ioctls QCCI's ipcr
# backend uses, same macro the legacy-um policy grants rild & friends.
allowxperm ims_enabler self:socket ioctl msm_sock_ipc_ioctls;
get_prop(ims_enabler, vendor_qmux_prop)
set_prop(ims_enabler, vendor_qmux_prop)

# No flip-script/su policy needed: qmux selection is static (kernel xprt
# auto-enable on xiaomi,pepito + init.qmux.rc triggers keyed on the
# libinit-set ro.vendor.qmux.enable, same vendor_qmux_prop context).

# THE AT_SECURE TRAP, SELINUX EDITION (found on the first Enforcing cold boot,
# 2026-07-10): the qmux services originally shipped `setenv LD_PRELOAD
# libqmi_force_ipcr.so`, but without `noatsecure` on the init→domain
# transition the kernel sets AT_SECURE=1 and bionic silently scrubs
# LD_PRELOAD (and LD_LIBRARY_PATH — qmux_rmt_storage's A8 closure).
# The noatsecure check is dontaudited in core policy, so NO denial ever
# appears, and granting it is impossible: `neverallow init *:process
# noatsecure` (b/140789528). Symptom signature: LD_PRELOAD present in
# /proc/<pid>/environ but absent from maps. RESOLUTION (no policy): the shim
# rides as DT_NEEDED — patched into the nightly QMI blobs + pm-service via
# extract-files.py blob_fixups, linked into the source-built gnss service and
# ims_enabler — and qmux_rmt_storage + its closure carry DT_RUNPATH
# /vendor/lib64/qmux instead of LD_LIBRARY_PATH.

# wfc_wlan_bridge — VoWiFi WLAN feeder (init.qmux.rc, PLAN-vowifi.md part 41).
# A QMI client on the ipc_router (generic socket) exactly like ims_enabler,
# PLUS it reads wlan0 over an AF_INET (udp) socket using wireless-extensions
# ioctls (BSSID/SSID/freq) + SIOCGIFADDR (IPv4). Vendor-lib loading (dlopen of
# libqmi_cci/libqmiservices) is covered by the global non-coredomain
# vendor_file_type rules in system/sepolicy.
type wfc_wlan_bridge, domain;
type wfc_wlan_bridge_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(wfc_wlan_bridge)

# ipc_router QMI (same pair as ims_enabler / rild): generic socket + the
# IPC-router service-discovery ioctl allowlist, and the qmux gate props.
allow wfc_wlan_bridge self:socket create_socket_perms;
allowxperm wfc_wlan_bridge self:socket ioctl msm_sock_ipc_ioctls;
get_prop(wfc_wlan_bridge, vendor_qmux_prop)
set_prop(wfc_wlan_bridge, vendor_qmux_prop)

# Read wlan0 on an inet/udp socket. GIW* + SIOCGIFADDR are read-only queries
# (no CAP_NET_ADMIN); scope the ioctl xperm to exactly what read_wlan() issues.
allow wfc_wlan_bridge self:udp_socket { create ioctl };
# SIOCGIWAP/SIOCGIWESSID live in priv_sock_ioctls, SIOCGIFADDR/SIOCGIWFREQ in
# unpriv_sock_ioctls — same grant legacy-um gives ims/netmgrd/location; the
# priv_sock_ioctls neverallows are app/media/drm-scoped, not this vendor domain.
allowxperm wfc_wlan_bridge self:udp_socket ioctl { unpriv_sock_ioctls priv_sock_ioctls };

# wfc_efswrite — VoWiFi ps_sys field-4 self-heal oneshot (init.qmux.rc,
# PLAN-vowifi.md parts 44-47). Unlike the QMI clients above it talks DCI/EFS2
# directly on /dev/diag (no ipc_router socket, no force-ipcr). It opens
# /dev/diag rw and issues the DCI register/deinit ioctls + EFS2 read/write — the
# same diag access qmux_rmt_storage's A8 stack gets (rw_file_perms includes
# ioctl; no allowxperm scoping on diag_device on this tree, per rmt_storage).
type wfc_efswrite, domain;
type wfc_efswrite_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(wfc_efswrite)

allow wfc_efswrite diag_device:chr_file rw_file_perms;

# Reads the qmux enable gate; reports its outcome in vendor.qmux.wfc_efswrite.
get_prop(wfc_efswrite, vendor_qmux_prop)
set_prop(wfc_efswrite, vendor_qmux_prop)
