# init.qmux.rc — qmux legacy-IPC modem path (pepito).
#
# Selection is STATIC, keyed on ro.vendor.qmux.enable (set per-variant by
# libinit: 1 on pepito, 0 on every other variant). The kernel half
# (ipc_router_rpmsg_xprt auto-enable) puts the modem edge on the legacy
# ipc_router from the first IPCRTR probe at cold boot, so there is no runtime
# flip, no mid-boot modem SSR, and no flip script: the services below simply
# start into the correct world. Bench A/B of the transport remains possible
# via the module param + persist.vendor.qmux.enable (see qmi_force_ipcr.c);
# diag-tools/qmux-flip-on.sh keeps the old runtime-flip recipe.
#
# The QMI-client daemons (qcrild/netmgrd/IMS) carry libqmi_force_ipcr as a
# patched-in DT_NEEDED (extract-files.py blob_fixups) which fails libqmi_cci's
# AF_QIPCRTR probe so it uses its native ipc_router backend; the shim
# self-gates on the qmux props, so it is a no-op anywhere qmux is off. NOT an
# LD_PRELOAD: init may never grant noatsecure (neverallow, b/140789528), so
# under Enforcing AT_SECURE=1 makes bionic silently scrub LD_PRELOAD/
# LD_LIBRARY_PATH — the first enforcing cold boot lost the shim in every
# preload-carrying service (no SIM) and qmux_rmt_storage crash-looped on its
# scrubbed LD_LIBRARY_PATH (its A8 closure is now found via patched-in
# DT_RUNPATH /vendor/lib64/qmux on the binary and every closure lib).
#
# The daemons start at `on boot` like their stock class-main equivalents;
# QCCI blocks until the modem's QMI services appear, so starting before the
# modem finishes PIL boot is the normal, stock-shaped sequence.

# Nightly (QRTR) rmt_storage for the non-qmux variants. The vendor blob rc
# (vendor.qti.rmt_storage.rc) is deliberately not shipped — it would free-run
# this on pepito too; definition mirrors it verbatim, plus `disabled`.
service vendor.rmt_storage /vendor/bin/rmt_storage
    class core
    user root
    shutdown critical
    ioprio rt 0
    disabled

# Stock A8 rmt_storage on the legacy IPC Router (serves the modem's RFSA
# buffer + EFS). Its private A8 lib closure is isolated under
# /vendor/lib64/qmux. shutdown critical + ioprio mirror the stock service:
# it must keep serving modem EFS through shutdown. The supplemental groups
# match what it actually opens — /sys/power/wake_lock (radio:wakelock 0660),
# /dev/uio0 (system 0660), /dev/diag (system:vendor_qti_diag 0660) — so bare
# root passes DAC without CAP_DAC_OVERRIDE (which sepolicy can never grant:
# dac_override is neverallowed outside the core allowlist).
service qmux_rmt_storage /vendor/bin/qmux_rmt_storage
    class core
    user root
    group system wakelock vendor_qti_diag
    shutdown critical
    ioprio rt 0
    disabled

# qcrild reaches its native ipc_router QMI backend via the force-ipcr shim
# (DT_NEEDED in the binary). Defined here (not via the vendor qcrild.rc blob,
# which reverts on extract). Mirrors vendor.qcrild's creds.
service qmux_qcrild /vendor/bin/hw/qcrild
    class main
    user radio
    group radio cache inet misc audio log readproc wakelock oem_2901
    capabilities BLOCK_SUSPEND NET_ADMIN NET_RAW
    disabled

# IMS daemons (VoLTE) — stock QTI service definitions (names, sockets, prop
# chain imsqmidaemon -> QMI_DAEMON_STATUS=1 -> imsdatadaemon ->
# DATA_DAEMON_STATUS=1 -> ims_rtp_daemon) ported from the nightly's vendor rc
# files, which we deliberately do NOT ship so they can never free-run outside
# the qmux path (they are QMI clients; the force-ipcr shim rides as DT_NEEDED).
service vendor.imsqmidaemon /vendor/bin/imsqmidaemon
    class main
    user radio
    socket ims_qmid stream 0660 system radio
    group radio vendor_qti_diag log
    disabled

service vendor.imsdatadaemon /vendor/bin/imsdatadaemon
    class main
    user radio
    socket ims_datad stream 0660 system radio
    group radio wifi inet vendor_qti_diag log
    disabled

service vendor.ims_rtp_daemon /vendor/bin/ims_rtp_daemon
    class main
    user system
    group radio vendor_qti_diag inet log
    disabled

# VoLTE self-heal oneshot: asserts modem NV ims_test_mode=0 + qipcall bools
# over v01 IMSS QMI (the A15 qcril ims module is v02-only and cannot). NV
# persists in modem EFS, so the steady-state run is read-only (status prop
# vendor.qmux.ims_enabler = ok); a fresh/refurb/EFS-wiped unit gets the
# writes re-applied (= applied). Retries internally until the modem is up.
service qmux_ims_enabler /vendor/bin/ims_enabler
    class main
    user radio
    group radio log
    oneshot
    disabled

# VoWiFi WLAN feeder: persistent daemon that polls wlan0 and, while associated,
# feeds the modem DSD WLAN available (0x20) + measurement (0x3c) so it brings up
# IWLAN / the ePDG tunnel for Wi-Fi calling (nothing else on our stack tells the
# legacy modem Wi-Fi exists; see PLAN-vowifi.md part 41). QMI client on the
# ipc_router via the force-ipcr DT_NEEDED; reads wlan0 over an inet socket
# (wireless-extensions ioctls). Not oneshot — it tracks Wi-Fi state for the
# life of the boot. Status prop vendor.qmux.wfc_bridge.
service qmux_wfc_bridge /vendor/bin/wfc_wlan_bridge
    class main
    user radio
    group radio inet log
    disabled

# VoWiFi ps_sys field-4 self-heal oneshot: arms the modem's per-PDN WLAN data
# config (ps_sys_data_configurations.txt field 4 = 1) that a fresh unit needs
# for the ePDG/reverse-rmnet tunnel to come up (PLAN-vowifi.md parts 44-47).
# EFS write over DCI/EFS2 on /dev/diag (NOT QMI); parse-anchored, single-byte,
# write-if-0, fail-safe — a no-op on an already-armed unit. Runs as root (needs
# /dev/diag rw + the DCI ioctls). Gated on the user's WFC toggle like the feeder
# below, so a unit whose owner never enables WFC never gets an EFS write. Status
# prop vendor.qmux.wfc_efswrite = off|ok|applied|error.
service qmux_wfc_efswrite /vendor/bin/wfc_efswrite
    class main
    user root
    # vendor_qti_diag is the group that owns /dev/diag (crw-rw---- system
    # vendor_qti_diag); joining it lets the DCI open pass the DAC group check
    # WITHOUT CAP_DAC_OVERRIDE (which the wfc_efswrite domain deliberately does
    # not get). See PLAN-vowifi.md part 47 flash #1.
    group root vendor_qti_diag
    oneshot
    disabled

# netmgrd (mobile data): programs the kernel rmnet_ipa data path over
# WDS/WDA/IPA QMI. A QMI client -> carries the force-ipcr shim (DT_NEEDED);
# the nightly netmgrd.rc is deliberately NOT shipped (it would free-run
# netmgrd). Runs as root like the stock service definition.
service qmux_netmgrd /vendor/bin/netmgrd
    class main
    user root
    disabled

on post-fs-data && property:ro.vendor.qmux.enable=1
    # netmgrd runtime dirs (stock netmgrd.rc equivalents)
    mkdir /data/vendor/netmgr 0770 radio radio
    mkdir /data/vendor/netmgr/recovery 0700 radio radio
    write /data/vendor/netmgr/recovery/recovery_info ""
    chown radio radio /data/vendor/netmgr/recovery/recovery_info

# The qmux world. Modem PIL boot happens much later than `boot`, so
# qmux_rmt_storage (class core creds, started here) is always up first, and
# the QMI clients wait on service discovery like their stock counterparts.
on boot && property:ro.vendor.qmux.enable=1
    # netmgrd runtime env (stock netmgrd.rc equivalents)
    mkdir /dev/socket/netmgr 0750 radio radio
    write /proc/sys/net/core/rmem_max 16777216
    write /proc/sys/net/core/wmem_max 8388608
    start qmux_rmt_storage
    start qmux_qcrild
    start qmux_netmgrd
    # imsqmidaemon kicks the stock IMS prop chain; ims_rtp_daemon is also
    # started directly so the imsrtpservice HAL is up before the data daemon
    # reports in. Framework side is org.codeaurora.ims binding IImsRadio on
    # qmux_qcrild. GPS needs no start here: the gnss HAL (lazy-started by the
    # location framework) links the same self-gating shim.
    start vendor.imsqmidaemon
    start vendor.ims_rtp_daemon
    # VoLTE NV self-heal (oneshot; QCCI waits for the modem internally, and
    # ordering vs the IMS daemons is irrelevant — it only touches modem NV).
    start qmux_ims_enabler
    # NOTE: qmux_wfc_bridge (the VoWiFi feeder) is NOT started here — it is
    # gated on the user's Wi-Fi-calling toggle below, so it does not run (and
    # burns no power feeding the modem) when WFC is off in Settings.

# VoWiFi WLAN feeder start/stop, gated on the user's Wi-Fi-calling setting.
# WfcBridge (a small platform app, ContentObserver on Settings wfc_ims_enabled)
# mirrors the toggle into persist.sys.pepito.wfc_enabled; the value is persisted
# so it is restored early on reboot (no bring-up latency vs the old boot start).
# Started only when qmux is the active modem path AND WFC is on; stopped the
# moment WFC is turned off. The daemon self-establishes IWLAN then idles
# (see wfc_wlan_bridge.c).
on property:persist.sys.pepito.wfc_enabled=1 && property:ro.vendor.qmux.enable=1
    start qmux_wfc_bridge
    # One-shot: arm ps_sys field 4 in modem EFS the first time WFC is enabled
    # (no-op once armed). Runs alongside the feeder; the modem may only re-read
    # this config at cold boot, so on a truly fresh unit the field is written
    # here and takes effect on the next boot (WFC still zero-touch thereafter).
    start qmux_wfc_efswrite

on property:persist.sys.pepito.wfc_enabled=0
    stop qmux_wfc_bridge

# The nightly (QRTR) world for every other variant.
on boot && property:ro.vendor.qmux.enable=0
    start vendor.rmt_storage

on property:vendor.ims.QMI_DAEMON_STATUS=1
    start vendor.imsdatadaemon

on property:vendor.ims.DATA_DAEMON_STATUS=1
    restart vendor.ims_rtp_daemon
