# qcrild.rc — [qmux] device-tree override of the vendor blob (removed from
# proprietary-files.txt), matching stock. The force-ipcr shim is a patched-in
# DT_NEEDED of the qcrild binary itself (extract-files.py blob_fixups), NOT an
# LD_PRELOAD: init may not grant noatsecure, so under Enforcing bionic scrubs
# LD_PRELOAD (see qmux/Android.bp). The shim self-gates on the qmux props
# — see PLAN-qmux.md / PLAN-qmux-bridge.md.
# Services stay `disabled`: on pepito telephony runs as qmux_qcrild
# (init.qmux.rc, started on boot where ro.vendor.qmux.enable=1), and this
# override exists so the vendor blob rc can never free-run vendor.qcrild.

service vendor.qcrild /vendor/bin/hw/qcrild
    class main
    user radio
    group radio cache inet misc audio log readproc wakelock oem_2901
    capabilities BLOCK_SUSPEND NET_ADMIN NET_RAW
    disabled

service vendor.qcrild2 /vendor/bin/hw/qcrild -c 2
    class main
    user radio
    group radio cache inet misc audio log readproc wakelock oem_2901
    capabilities BLOCK_SUSPEND NET_ADMIN NET_RAW
    disabled

service vendor.qcrild3 /vendor/bin/hw/qcrild -c 3
    class main
    user radio
    group radio cache inet misc audio log readproc wakelock oem_2901
    capabilities BLOCK_SUSPEND NET_ADMIN NET_RAW
    disabled
