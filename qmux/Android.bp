// libqmi_force_ipcr (the socket()-interposing force-ipcr shim) moved to
// device/xiaomi/mithorium-common/libshim/ — the family-wide gnss service
// links it and soong namespaces only import downward (mithorium-common
// cannot see modules defined here). It rides as DT_NEEDED of its consumers,
// never LD_PRELOAD (bionic scrubs LD_PRELOAD under Enforcing: neverallow
// init *:process noatsecure, b/140789528). See PLAN-qmux-bridge.md.

// ims_enabler — [qmux, VoLTE productization] boot oneshot that asserts the
// modem NV settings IMS registration depends on (ims_test_mode=0 + qipcall
// bools), so fresh flashes / EFS-wiped units self-heal. QMI blobs are
// dlopen()ed at runtime (no import libs for the vendor prebuilts); the
// ipc_router transport comes from linking libqmi_force_ipcr (in the global
// group it interposes socket() for the dlopen()ed libs too). See
// PLAN-volte.md.
cc_binary {
    name: "ims_enabler",
    srcs: ["ims_enabler.c"],
    vendor: true,
    shared_libs: [
        "libqmi_force_ipcr",
        "liblog",
    ],
    cflags: ["-Wall", "-Werror"],
}

// wfc_wlan_bridge — [qmux, VoWiFi productization] persistent daemon that polls
// wlan0 and feeds the legacy modem DSD WLAN available (0x20) + measurement
// (0x3c) reports so IWLAN / the ePDG tunnel come up for Wi-Fi calling. Same
// QMI-over-ipc_router pattern as ims_enabler (dlopen libqmi_cci/libqmiservices,
// ipc_router forced by linking libqmi_force_ipcr). See PLAN-vowifi.md part 41.
cc_binary {
    name: "wfc_wlan_bridge",
    srcs: ["wfc_wlan_bridge.c"],
    vendor: true,
    shared_libs: [
        "libqmi_force_ipcr",
        "liblog",
    ],
    cflags: ["-Wall", "-Werror"],
}

// wfc_efswrite — [qmux, VoWiFi productization] toggle-gated modem-EFS write
// that arms ps_sys "field 4" = 1 for Wi-Fi calling on a fresh unit. Transport
// is DCI/EFS2 over /dev/diag (a minimal write-if-0 subset of
// diag-tools/efs2-probe), NOT QMI — so no libqmi_force_ipcr. Started by init on
// the user's WFC toggle; parse-anchored, single-byte, fail-safe. See
// PLAN-vowifi.md parts 44-47.
cc_binary {
    name: "wfc_efswrite",
    srcs: ["wfc_efswrite.c"],
    vendor: true,
    shared_libs: [
        "liblog",
    ],
    cflags: ["-Wall", "-Werror"],
}

// modem_b12 — [qmux, Modem Tweaks] LTE Band 12 switch. Writes the four B12 RF
// calibration items (shipped below) and NV 6828 bit 11 over DCI on /dev/diag,
// gated on persist.gotweak.modem_b12. Diag-only like wfc_efswrite, so no
// libqmi_force_ipcr. See modem_b12.c.
cc_binary {
    name: "modem_b12",
    srcs: ["modem_b12.c"],
    vendor: true,
    init_rc: ["init.modem_b12.rc"],
    required: [
        "modem_b12_rfnv_00022169",
        "modem_b12_rfnv_00022170",
        "modem_b12_rfnv_00024237",
        "modem_b12_rfnv_00027790",
    ],
    shared_libs: [
        "liblog",
    ],
    cflags: ["-Wall", "-Werror"],
}

// B12 RF calibration items, byte-for-byte from the factory `tunning` partition
// (a plain tar of factory RF cal) of the one PVG100 seen with B12 enabled from
// the factory. Calibration is per unit (every comparable item differs across
// eight dumped units, by small amounts), so on any other phone these are close,
// not exact. Installed to /vendor/etc/modem_b12/.
prebuilt_etc {
    name: "modem_b12_rfnv_00022169",
    src: "b12/00022169",
    filename: "00022169",
    sub_dir: "modem_b12",
    vendor: true,
}

prebuilt_etc {
    name: "modem_b12_rfnv_00022170",
    src: "b12/00022170",
    filename: "00022170",
    sub_dir: "modem_b12",
    vendor: true,
}

prebuilt_etc {
    name: "modem_b12_rfnv_00024237",
    src: "b12/00024237",
    filename: "00024237",
    sub_dir: "modem_b12",
    vendor: true,
}

prebuilt_etc {
    name: "modem_b12_rfnv_00027790",
    src: "b12/00027790",
    filename: "00027790",
    sub_dir: "modem_b12",
    vendor: true,
}
