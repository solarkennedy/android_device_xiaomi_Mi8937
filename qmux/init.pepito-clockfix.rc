# init.pepito-clockfix.rc — AP wall clock across boots without touching the
# PMIC RTC (see pepito_clockfix.c). The RTC is a read-only raw counter on this
# platform, so the kernel boots the clock at 1970 + counter; this stores the
# wall-minus-counter offset once the clock is plausible and re-applies it at
# the next boot before anything that cares about the date starts. Pepito only
# (ro.vendor.qmux.enable=1): the siblings' nightly never had it either, and
# the state lives in the legacy time-services dir (vendor_time_data_file).

service pepito_clockfix_restore /vendor/bin/pepito_clockfix restore
    user system
    group system
    capabilities SYS_TIME
    oneshot
    disabled

service pepito_clockfix_save /vendor/bin/pepito_clockfix save
    user system
    group system
    oneshot
    disabled

# exec_start: init waits for the (millisecond) run, so the clock is right
# before the `boot` services start.
on post-fs-data && property:ro.vendor.qmux.enable=1
    mkdir /data/vendor/time 0700 system system
    exec_start pepito_clockfix_restore

# Network time has normally landed by boot_completed (NTP ~38 s on Wi-Fi);
# the save is a no-op while the clock is still at 1970.
on property:sys.boot_completed=1 && property:ro.vendor.qmux.enable=1
    exec_start pepito_clockfix_save

# Refresh at shutdown so RTC-vs-system drift stays at seconds.
on property:sys.shutdown.requested=* && property:ro.vendor.qmux.enable=1
    exec_start pepito_clockfix_save
