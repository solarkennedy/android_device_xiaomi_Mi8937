<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Is the notification LED intrusive? Used to decide if there should be a disable option -->
    <bool name="config_intrusiveNotificationLed">true</bool>

    <!-- Package that holds the SYSTEM_AUTOMOTIVE_PROJECTION role. Grants gearhead the role
         (and its REQUEST_COMPANION_PROFILE_AUTOMOTIVE_PROJECTION permission) so it can create the
         CompanionDeviceManager automotive-projection association required for wired Android Auto. -->
    <string name="config_systemAutomotiveProjection" translatable="false">com.google.android.projection.gearhead</string>

    <!-- Default holder of the ASSISTANT role. With the Google app baked into the gapps build
         (vendor/pepito-gapps GoogleSearch payload) the role would otherwise start empty on a
         fresh flash, which kills Android Auto voice commands. Harmless on the vanilla target:
         if the package doesn't exist the role simply stays empty as before. -->
    <string name="config_defaultAssistant" translatable="false">com.google.android.googlequicksearchbox</string>
</resources>
