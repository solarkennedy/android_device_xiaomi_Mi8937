<resources>
    <!-- Paranoid Sense (FaceUnlock) reports its 4-hour idle lockout as
         FACE_ERROR_VENDOR with vendorCode 0. AOSP ships this array empty, so
         the keyguard fell back to face_error_vendor_unknown ("Something went
         wrong. Try again.") on every wake until the screen lock was entered.
         Index 0 = the idle lockout. -->
    <string-array name="face_error_vendor">
        <item>Face unlock paused. Use your screen lock.</item>
    </string-array>
</resources>
