<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- pepito has one physical SIM slot; mithorium-common defaults to 2 -->
    <integer name="config_num_physical_slots">1</integer>

    <!-- pepito has no capacitive nav keys; show the software nav bar -->
    <bool name="config_showNavigationBar">true</bool>

    <!-- default to gestural navigation (0=3-button, 1=2-button, 2=gestural) -->
    <integer name="config_navBarInteractionMode">2</integer>

    <!-- battery is a bigger deal on this phone than most; default to showing
         the percentage inside the status bar battery icon, matching stock
         Android's current look, rather than AOSP's default of hidden -->
    <bool name="config_defaultBatteryPercentageSetting">true</bool>

    <!-- Cap max backlight at stock PVG100's max luminance. Stock's brightness
         curve saturates at ~70-73% WLED duty (CT-3 wall measurement: stock max
         display power ~630mW vs 863mW at this panel's true 100% duty), so an
         uncapped max slider drives ~1.4x stock's light for +235mW. Both floats
         must be set together: if either is unset the framework falls back to
         the config_screenBrightnessSettingMinimum/Maximum ints
         (DisplayDeviceConfig.loadBrightnessConstraintsFromConfigXml).
         0.0 matches the existing int minimum of 1. -->
    <item name="config_screenBrightnessSettingMinimumFloat" format="float" type="dimen">0.0</item>
    <item name="config_screenBrightnessSettingMaximumFloat" format="float" type="dimen">0.73</item>
</resources>
